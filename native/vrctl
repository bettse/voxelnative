#!/usr/bin/env python3
"""Drive the sim app's control channel (Sources/SimControl.swift).

Start the app and keep it running:  SIM_KEEP=1 ./sim.sh
Then each argument is one command, run in order:

  ./vrctl "down w" "sleep 1.5" "up w" "tap i" "sleep 1" "aim main 3" "tap enter" "state" "shot /tmp/a.png"

Mac-side commands: sleep <sec>, shot <path> (simctl screenshot), help.
Everything else goes to the app; `./vrctl help` lists them.
With no arguments, reads commands from stdin (one per line).
"""
import os, socket, subprocess, sys, time

SIM = os.environ.get("VRSIM", "AAA51166-3572-43B8-9B71-9090483A2301")
PORT = int(os.environ.get("VRPORT", "7070"))


def connect():
    for _ in range(20):
        try:
            s = socket.create_connection(("127.0.0.1", PORT), timeout=5)
            return s, s.makefile("r")
        except OSError:
            time.sleep(0.5)
    sys.exit(f"vrctl: nothing listening on 127.0.0.1:{PORT} (is the app running? SIM_KEEP=1 ./sim.sh)")


def run(cmds):
    sock, rd = None, None
    for c in cmds:
        c = c.strip()
        if not c or c.startswith("#"):
            continue
        if c.startswith("sleep "):
            time.sleep(float(c.split()[1]))
            continue
        if c.startswith("shot "):
            path = c.split(maxsplit=1)[1]
            subprocess.run(["xcrun", "simctl", "io", SIM, "screenshot", path],
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"shot {path}")
            continue
        if sock is None:
            sock, rd = connect()
        sock.sendall((c + "\n").encode())
        reply = rd.readline().rstrip("\n")
        if reply != "ok":
            print(reply if not reply.startswith("err") else f"{c}: {reply}")
        if reply.startswith("err"):
            sys.exit(1)


if __name__ == "__main__":
    run(sys.argv[1:] if len(sys.argv) > 1 else sys.stdin.read().splitlines())
